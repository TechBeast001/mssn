rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Anyone can read public platform information, events, articles, causes, executives, and sessions
    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if true;
    }

    match /site_content/{contentId} {
      allow read: if true;
      allow write: if true;
    }

    match /members/{memberId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /executives/{execId} {
      allow read: if true;
      allow write: if true;
    }

    match /committees/{commId} {
      allow read: if true;
      allow write: if true;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    match /articles/{artId} {
      allow read: if true;
      allow write: if true;
    }

    match /gallery/{galId} {
      allow read: if true;
      allow write: if true;
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if true;
    }

    match /causes/{causeId} {
      allow read: if true;
      allow write: if true;
    }

    match /donations/{donationId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /logs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }

    match /certificates/{certId} {
      allow read: if true;
      allow write: if true;
    }

    match /elibrary/{elibId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
