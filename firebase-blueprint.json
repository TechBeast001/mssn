    "members": {
      "title": "Members",
      "description": "Registered students and members of MSSN FUD",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "membershipId": { "type": "string" },
        "fullName": { "type": "string" },
        "matricNumber": { "type": "string" },
        "faculty": { "type": "string" },
        "department": { "type": "string" },
        "level": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
